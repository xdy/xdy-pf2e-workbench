<section class="content">
    {{#each settings as |setting|}}
        <div class="form-group">
            <label for="{{setting.key}}">{{localize setting.name}}</label>
            <div class="form-fields">
                {{#if setting.isFilepicker}}
                    <file-picker name="{{setting.key}}" value="{{setting.value}}"
                                 type="{{setting.filePicker}}"></file-picker>
                {{else if setting.fieldPartial}}
                    {{> (lookup setting 'fieldPartial') key=setting.key value=setting.value
                        choices=setting.choices range=setting.range type=setting.type}}
                {{/if}}
            </div>
            <p class="hint">{{localize setting.hint}}</p>
        </div>
    {{/each}}
</section>
